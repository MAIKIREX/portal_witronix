# ==========================================================
# Portal Witronix - variables de entorno (desarrollo local)
# Copiar a .env y ajustar. NUNCA commitear el .env real.
# ==========================================================

NODE_ENV=development

# ---------- Base de datos ----------
POSTGRES_USER=witronix
POSTGRES_PASSWORD=witronix_dev
POSTGRES_DB=witronix_portal
POSTGRES_PORT=5433
DATABASE_URL="postgresql://witronix:witronix_dev@localhost:5433/witronix_portal?schema=public"

# ---------- API ----------
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ---------- JWT ----------
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambiar_este_valor_en_produccion_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar_este_valor_en_produccion_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Tokens de un solo uso ----------
INVITATION_EXPIRES_HOURS=72
PASSWORD_RESET_EXPIRES_HOURS=2

# ---------- Storage (MinIO / compatible S3) ----------
# Al migrar a Cloudflare R2 o S3 solo cambian estas variables.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=witronix
STORAGE_SECRET_KEY=witronix_dev_secret
STORAGE_BUCKET=witronix-portal
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_UPLOAD_TTL=900
STORAGE_PRESIGN_DOWNLOAD_TTL=300
STORAGE_MAX_FILE_SIZE_MB=500

MINIO_ROOT_USER=witronix
MINIO_ROOT_PASSWORD=witronix_dev_secret
MINIO_BUCKET=witronix-portal
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Email (Mailpit en local) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Portal Witronix <no-reply@witronixled.com>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- Frontend ----------
PORTAL_URL=http://localhost:3000

# NOTA: el contenedor usa el puerto 5433 y no el 5432 porque esta maquina
# ya tiene un PostgreSQL 18 instalado como servicio de Windows ocupando
# el 5432. Asi conviven sin tocar la instalacion existente.
