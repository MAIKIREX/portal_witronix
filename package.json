{
  "name": "witronix-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Portal privado de gestion de proyectos de iluminacion, domotica e inmotica - Witronix",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "dev:api": "pnpm --filter @witronix/shared build && pnpm --filter @witronix/api start:dev",
    "dev:web": "pnpm --filter @witronix/web dev",
    "build": "pnpm --filter @witronix/shared build && pnpm -r --filter=!@witronix/shared build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @witronix/api prisma:migrate",
    "db:seed": "pnpm --filter @witronix/api prisma:seed",
    "db:studio": "pnpm --filter @witronix/api prisma:studio",
    "db:reset": "pnpm --filter @witronix/api prisma:reset",
    "build:shared": "pnpm --filter @witronix/shared build"
  }
}
